# EXISTING WORKSPACE CONNECTION
# Keep existing values when updating. Automatic discovery is off until configured and enabled.
# Supabase project → Connect → application/framework → Next.js.
# Project URL looks like https://your-project.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key. Database row-level security protects your records.
# Never use an administrative secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon-key alternative; leave blank when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AUTOMATIC LEAD DISCOVERY — private server settings, never paste into chat or GitHub.
# Supabase Settings → API Keys: server secret key (sb_secret_...) OR legacy service_role key.
# This administrative key must match the same Supabase project above.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Authentication → Users → your own sign-in account → User UID.
# Unattended prospecting writes only to this existing owner's workspace.
AUTOMATION_OWNER_ID=
# Create a Hunter account → API keys. Check access to Discover, Company Enrichment,
# Domain Search and Email Verifier. Hunter's example test-api-key is not accepted.
# A real provider key and sufficient endpoint credits/plan access are required.
HUNTER_API_KEY=
# Full app origin. localhost locally; your actual https://...vercel.app origin when hosted.
APP_URL=http://localhost:3000
# Inngest production environment → Event key and Signing key.
# Both are required for hosted unattended scheduling. Keep these keys server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# LOCAL TESTING ONLY: set to 1 with npm run dev + npm run dev:jobs in a second terminal.
# Leave blank when hosted/production. A local-only app stops working when your computer is off.
INNGEST_DEV=
# OPTIONAL AI summaries for review: create an Anthropic account and API key.
# Set both values and enable AI in discovery settings. No model is guessed automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# LATER FEATURES — unused until their implementation; these do not enable email/payment sending now.
# Future Resend email API key and verified sender; or use your SMTP provider below.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Future verified reply webhooks or secure IMAP reply capture.
REPLY_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Future optional Apollo connector. Google Places durable CRM ingestion is not enabled.
APOLLO_API_KEY=
GOOGLE_PLACES_API_KEY=
# Future Stripe dashboard → Developers → API keys / Webhooks, or a PayPal payment link.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_PAYMENT_LINK=
# Future optional owner notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
