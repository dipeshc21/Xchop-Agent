# REQUIRED: Open your Supabase project → Connect → application/framework → Next.js.
# The project URL looks like https://your-project.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key. It is intended for browser use; database RLS protects records.
# Never put a service_role key, Supabase secret key, or database password here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional compatibility alternative: legacy Supabase anon key.
# Leave blank when you use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your app address. Keep this value while running on your Windows computer.
APP_URL=http://localhost:3000

# FUTURE FEATURES — these connections are not used by the current live foundation.
# Keep private keys server-only. Never prefix a private key with NEXT_PUBLIC_.
# Anthropic console → API Keys, for future AI features.
ANTHROPIC_API_KEY=
# Resend dashboard → API Keys; future email sending also needs a verified domain.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
# Alternative SMTP provider settings, supplied by your mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Future verified reply webhooks or secure IMAP reply capture.
REPLY_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Inngest app event and signing keys, for future scheduled background workers.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional official API connectors; future lead-import/enrichment work.
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
# Future Stripe payments: dashboard → Developers → API keys / Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Future PayPal payment-link alternative. Enter a link, never a password.
PAYPAL_PAYMENT_LINK=
# Future optional owner notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
