# EXISTING WORKSPACE CONNECTION — keep your existing values when updating.
# Supabase project → Connect → application/framework → Next.js.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key; database row-level security protects your records.
# Never put a server secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon-key alternative; leave blank when using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PUBLIC PROJECT-REQUEST DISCOVERY — server-only values, never commit or share them.
# Create a Tavily account at https://app.tavily.com/ → API keys.
# Searches count against your provider credits even when no page qualifies.
TAVILY_API_KEY=
# Supabase Settings → API Keys: server secret (sb_secret_...) OR legacy service_role key.
# This administrative key must match the same Supabase project above.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Authentication → Users → the account you sign into this app with → User UID.
# This is a user UUID, not the Supabase project ID.
AUTOMATION_OWNER_ID=
# Full app origin: localhost locally; your actual https://...vercel.app origin when hosted.
APP_URL=http://localhost:3000
# Inngest Production → Event key and separate Signing key. Keep both server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# LOCAL ONLY: set to 1 with npm run dev + npm run dev:jobs in a second terminal.
# Leave unset/blank in hosted production. Local services stop when your computer is off.
INNGEST_DEV=

# LEGACY CONTACT RESEARCH — not required or used by the new project-request worker.
# Existing contacts remain available as unconfirmed contacts; these keys do not prove demand.
HUNTER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# LATER FEATURES — these values do not enable automatic email or payment sending now.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPLY_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
APOLLO_API_KEY=
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_PAYMENT_LINK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
