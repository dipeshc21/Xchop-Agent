# PHASE 1 — true means fake data, no accounts or API keys required.
# Set to false only after you complete the Supabase setup in README.md.
NEXT_PUBLIC_DEMO_MODE=true
# Your Supabase project URL: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (safe for the browser; database security relies on RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase service_role key. Needed only for the optional seed command.
# NEVER prefix this key with NEXT_PUBLIC_ or paste it into the app UI.
SUPABASE_SERVICE_ROLE_KEY=
# UUID of your existing Supabase Auth user, for the optional seed command only.
SEED_OWNER_ID=
# Your app address; localhost while testing, your own domain when deployed.
APP_URL=http://localhost:3000
# PHASE 3 — reserved for later implementation; unused in Phase 1.
# Anthropic console → API Keys → Create key.
ANTHROPIC_API_KEY=
# Resend dashboard → API Keys. Also verify your sending domain.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
# SMTP alternative; mail provider supplies these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Reply capture method and provider webhook signing secret (Phase 4).
REPLY_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Inngest dashboard → app keys. Both are server-only.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# PHASE 2 — optional official API connectors, disabled until implemented and configured.
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
# PHASE 6 — Stripe dashboard → Developers → API keys and Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal link option (never a password). Integration comes in Phase 6.
PAYPAL_PAYMENT_LINK=
# PHASE 5 — optional Telegram notifications, unused in Phase 1.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional WhatsApp Business provider configuration comes in Phase 5.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
